{
  "name": "vite-plugin-dynamic-asset-emitter",
  "version": "0.1.0",
  "description": "Serve dynamic assets in Vite development and write them to the build output",
  "author": "LigeroTheTiger",
  "license": "WTFNMFPL",
  "keywords": [
    "vite",
    "dynamic-assets",
    "plugin",
    "vite-plugin"
  ],
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/LigeroTheTiger/vite-plugin-dynamic-asset-emitter.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "npm run build && tsc -p tsconfig.test.json && tsc -p examples/playground/tsconfig.json",
    "test": "npm run typecheck && node --test",
    "lint": "eslint --fix --report-unused-disable-directives",
    "playground": "npm run build && vite examples/playground --host 127.0.0.1",
    "playground:build": "npm run build && vite build examples/playground",
    "playground:preview": "vite preview examples/playground --host 127.0.0.1"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1",
    "@types/node": "^24.0.0",
    "jiti": "^2.7.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.0"
  },
  "dependencies": {}
}
