{
  "name": "vite-plugin-dynamic-asset-emitter",
  "version": "0.1.0",
  "description": "Serve dynamic assets in Vite development and write them to the build output",
  "author": "LigeroTheTiger",
  "license": "WTFNMFPL",
  "keywords": [
    "vite",
    "dynamic-assets",
    "plugin",
    "vite-plugin"
  ],
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/LigeroTheTiger/vite-plugin-dynamic-asset-emitter.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "playground": "npm run build && vite examples/playground --host 127.0.0.1",
    "playground:build": "npm run build && vite build examples/playground",
    "playground:preview": "vite preview examples/playground --host 127.0.0.1"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.0"
  }
}
